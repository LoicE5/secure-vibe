{
  "version": "3.8.0",
  "scripts": {
    "start": "bun src/index.ts",
    "vibe": "bun run start",
    "env:init": "cp -n .env.example .env",
    "build": "bun run scripts/build.ts && bun run cleanup",
    "build:linux-x64": "bun run scripts/build.ts linux-x64 && bun run cleanup",
    "build:linux-arm64": "bun run scripts/build.ts linux-arm64 && bun run cleanup",
    "build:macos-x64": "bun run scripts/build.ts macos-x64 && bun run cleanup",
    "build:macos-arm64": "bun run scripts/build.ts macos-arm64 && bun run cleanup",
    "cleanup": "rm -f ./.*-*.bun-build",
    "docker:build:claude": "docker build -f docker/claude.dockerfile -t ghcr.io/loice5/secure-vibe/claude:latest .",
    "docker:build:claude:no-cache": "docker build --no-cache -f docker/claude.dockerfile -t ghcr.io/loice5/secure-vibe/claude:latest .",
    "docker:pull:claude": "docker pull ghcr.io/loice5/secure-vibe/claude:latest",
    "docker:build:antigravity": "docker build -f docker/antigravity.dockerfile -t ghcr.io/loice5/secure-vibe/antigravity:latest .",
    "docker:build:antigravity:no-cache": "docker build --no-cache -f docker/antigravity.dockerfile -t ghcr.io/loice5/secure-vibe/antigravity:latest .",
    "docker:pull:antigravity": "docker pull ghcr.io/loice5/secure-vibe/antigravity:latest",
    "docker:build:ccr": "docker build -f docker/ccr.dockerfile -t ghcr.io/loice5/secure-vibe/ccr:latest .",
    "docker:build:ccr:no-cache": "docker build --no-cache -f docker/ccr.dockerfile -t ghcr.io/loice5/secure-vibe/ccr:latest .",
    "docker:pull:ccr": "docker pull ghcr.io/loice5/secure-vibe/ccr:latest",
    "docker:build:codex": "docker build -f docker/codex.dockerfile -t ghcr.io/loice5/secure-vibe/codex:latest .",
    "docker:build:codex:no-cache": "docker build --no-cache -f docker/codex.dockerfile -t ghcr.io/loice5/secure-vibe/codex:latest .",
    "docker:pull:codex": "docker pull ghcr.io/loice5/secure-vibe/codex:latest",
    "docker:build:vibe": "docker build -f docker/vibe.dockerfile -t ghcr.io/loice5/secure-vibe/vibe:latest .",
    "docker:build:vibe:no-cache": "docker build --no-cache -f docker/vibe.dockerfile -t ghcr.io/loice5/secure-vibe/vibe:latest .",
    "docker:pull:vibe": "docker pull ghcr.io/loice5/secure-vibe/vibe:latest",
    "setup:alias": "bun scripts/alias.ts",
    "setup:completion": "bun scripts/completion.ts",
    "prune:brew": "docker volume rm secure-vibe-brew",
    "prune:image:claude": "docker rmi ghcr.io/loice5/secure-vibe/claude:latest",
    "prune:image:antigravity": "docker rmi ghcr.io/loice5/secure-vibe/antigravity:latest",
    "prune:image:ccr": "docker rmi ghcr.io/loice5/secure-vibe/ccr:latest",
    "prune:image:codex": "docker rmi ghcr.io/loice5/secure-vibe/codex:latest",
    "prune:image:vibe": "docker rmi ghcr.io/loice5/secure-vibe/vibe:latest"
  },
  "devDependencies": {
    "@types/bun": "latest"
  }
}
