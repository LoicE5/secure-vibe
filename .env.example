# secure-vibe never prompts. Anything left unset uses its default.

# Default provider: claude | antigravity | ccr | codex | vibe
# SECURE_VIBE_PROVIDER=claude

# Directory to mount into the container. Defaults to the current directory.
# SECURE_VIBE_DIRECTORY=.

# Container runtime: docker | podman
# If not set and both are available, docker is used (falls back to podman).
# SECURE_VIBE_RUNTIME=docker

# Save mode before starting: zip | copy | no. Defaults to no.
# SECURE_VIBE_SAVE=zip

# Command to run inside the container (default: the selected provider's entrypoint).
# Shell metacharacters are supported (the command is wrapped in bash -c automatically).
# SECURE_VIBE_COMMAND=bash

# Files to exclude from the container (comma-separated glob patterns).
# Matched files are physically moved out of the repo before the container starts
# and restored automatically after it exits. A warning is printed for non-gitignored files.
# SECURE_VIBE_EXCLUDE=.npmrc,.nvmrc,**/*.pem

# Force image rebuild (any of: true, 1, yes). Equivalent to --build.
# SECURE_VIBE_BUILD=true

# Force image rebuild without cache. Equivalent to --build-no-cache.
# SECURE_VIBE_BUILD_NO_CACHE=true

# Force-pull the latest image before starting (any of: true, 1, yes). Equivalent to --pull.
# SECURE_VIBE_PULL=true

# CCR provider only (--ccr / --claude-code-router): allow the container to reach models
# running on the HOST machine (e.g. Ollama at http://host.docker.internal:11434).
# Adds only --add-host=host.docker.internal:host-gateway — no published ports, no host network.
# Equivalent to --local.
# SECURE_VIBE_LOCAL=true

# Use the docker-in-docker image variant (any of: true, 1, yes), giving the agent its own
# rootless Docker daemon. This is the one setting that relaxes isolation: it adds --privileged
# to the container and drops seccomp/AppArmor confinement. The agent stays non-root and nested
# containers cannot reach your machine. See the README before turning it on.
# Equivalent to --dind (or --docker).
# SECURE_VIBE_DIND=true

# Provider API keys for CCR are NOT taken from any .env wholesale. CCR resolves keys via
# $VAR/${VAR} references inside ~/.claude-code-router/config.json. secure-vibe parses that
# config and forwards ONLY the referenced variables, resolving each from the mounted project's
# .env first, then your exported environment and these repository defaults. An unreferenced
# variable is never forwarded.
# Example — if config.json contains "api_key": "$OPENROUTER_API_KEY":
# OPENROUTER_API_KEY=sk-or-...
